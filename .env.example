VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Canonical HTTPS origin for invite/post/profile shares (APK + web).
# Example: https://app.lovli.com
VITE_PUBLIC_APP_URL=

# Direct APK download (GitHub Release / R2 / CDN). Shown on /get-app.
# Package: com.lovli.app
VITE_APK_DOWNLOAD_URL=

# OpenRouter (also set in Supabase Edge Function Secrets)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324
