{
  "expo": {
    "name": "Lovli",
    "slug": "lovli",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "lovli",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#e11d48"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lovli.app"
    },
    "android": {
      "package": "com.lovli.app",
      "adaptiveIcon": {
        "backgroundColor": "#e11d48",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "lovlimatch.vercel.app",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "lovlimatch.vercel.app",
              "pathPrefix": "/get-app"
            },
            {
              "scheme": "https",
              "host": "lovlimatch.vercel.app",
              "pathPrefix": "/post"
            },
            {
              "scheme": "https",
              "host": "lovlimatch.vercel.app",
              "pathPrefix": "/u"
            },
            {
              "scheme": "https",
              "host": "lovlimatch.vercel.app",
              "pathPrefix": "/connection"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#e11d48",
          "defaultChannel": "lovli-default"
        }
      ],
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "9abcd22f-3a90-4165-bc9c-ed791b7ba139"
      }
    },
    "owner": "epicbda"
  }
}
